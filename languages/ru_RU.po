msgid "Setup checklist (%1$d of %2$d done)"
msgstr "Чек-лист настройки (готово %1$d из %2$d)"

#: inc/admin/class-welcome-screen.php:152
msgid "Do this now"
msgstr "Сделать сейчас"

#: inc/admin/class-welcome-screen.php:158
msgid "Not sure where to start?"
msgstr "Не знаете, с чего начать?"

#: inc/admin/class-welcome-screen.php:16
msgid "Studio Frame: Get Started"
msgstr "Studio Frame: Начало работы"

#: inc/admin/class-welcome-screen.php:160
msgid "Install one-click demo content — a few sample projects, testimonials and FAQ entries — to see how a finished site looks, then replace it with your own material at your own pace."
msgstr "Установите демо-контент в один клик — несколько примеров проектов, отзывов и вопросов FAQ — чтобы увидеть, как выглядит готовый сайт, а затем постепенно замените его своими материалами."

#: inc/admin/class-welcome-screen.php:165
msgid "Remove all demo projects, testimonials and FAQ entries?"
msgstr "Удалить все демо-проекты, отзывы и вопросы FAQ?"

#: inc/admin/class-welcome-screen.php:166
msgid "Remove demo content"
msgstr "Удалить демо-контент"

#: inc/admin/class-welcome-screen.php:17 inc/admin/class-admin-notices.php:47
msgid "Get Started"
msgstr "Начало работы"

#: inc/admin/class-welcome-screen.php:170
msgid "Install demo content"
msgstr "Установить демо-контент"

#: inc/admin/class-welcome-screen.php:175
msgid "Where to customize things"
msgstr "Где что настраивается"

#: inc/admin/class-welcome-screen.php:177
msgid "Customizer — text, colours, contact details, social links"
msgstr "Настройщик — тексты, цвета, контакты, соцсети"

#: inc/admin/class-welcome-screen.php:178
msgid "Projects — your portfolio entries"
msgstr "Проекты — записи вашего портфолио"

#: inc/admin/class-welcome-screen.php:179
msgid "Testimonials — client reviews shown on the homepage"
msgstr "Отзывы — отзывы клиентов на главной странице"

#: inc/admin/class-welcome-screen.php:180
msgid "FAQ — questions and answers shown on the homepage"
msgstr "FAQ — вопросы и ответы на главной странице"

#: inc/admin/class-welcome-screen.php:181
msgid "Menus — header and footer navigation"
msgstr "Меню — навигация в шапке и подвале"

#: inc/admin/class-welcome-screen.php:67
msgid "Upload your logo"
msgstr "Загрузите логотип"

#: inc/admin/class-welcome-screen.php:72
msgid "Set your contact e-mail (for booking requests)"
msgstr "Укажите e-mail для заявок"

#: inc/admin/class-welcome-screen.php:77
msgid "Create a primary menu"
msgstr "Создайте основное меню"

#: inc/admin/class-welcome-screen.php:82
msgid "Add at least one project to your portfolio"
msgstr "Добавьте хотя бы один проект в портфолио"

#: inc/admin/class-welcome-screen.php:87
msgid "Create an \"About\" page (assign the \"About the photographer\" template)"
msgstr "Создайте страницу «Обо мне» (назначьте шаблон «О фотографе»)"

#: inc/admin/class-welcome-screen.php:92
msgid "Create a \"Contacts\" page (assign the \"Contacts\" template)"
msgstr "Создайте страницу «Контакты» (назначьте шаблон «Контакты»)"

#: inc/admin/class-welcome-screen.php:97
msgid "Add a client testimonial (optional, but recommended)"
msgstr "Добавьте отзыв клиента (необязательно, но рекомендуется)"

#: inc/blocks/class-block-patterns.php:17
msgid "Studio Frame"
msgstr "Studio Frame"

#: inc/blocks/class-block-patterns.php:26
msgid "Call to action band"
msgstr "Блок призыва к действию"

#: inc/blocks/class-block-patterns.php:27
msgid "A full-width statement with two buttons, similar to the theme's own \"let's work together\" section."
msgstr "Полноширинный блок с текстом и двумя кнопками — как секция «Давайте работать вместе» в теме."

#: inc/blocks/class-block-patterns.php:32
msgid "Want to work together?"
msgstr "Хотите поработать вместе?"

#: inc/blocks/class-block-patterns.php:36
msgid "Tell me about your idea and I'll get back to you within a day or two."
msgstr "Расскажите о своей идее — я отвечу в течение одного-двух дней."

#: inc/blocks/class-block-patterns.php:42
msgid "Get in touch"
msgstr "Связаться"

#: inc/blocks/class-block-patterns.php:54
msgid "Portrait with text"
msgstr "Портрет с текстом"

#: inc/blocks/class-block-patterns.php:55
msgid "An image next to a heading and a paragraph, useful for a services page or a personal note."
msgstr "Изображение рядом с заголовком и текстом — пригодится для страницы услуг или личной истории."

#: inc/blocks/class-block-patterns.php:70
msgid "A heading goes here"
msgstr "Здесь заголовок"

#: inc/blocks/class-block-patterns.php:74
msgid "Write a couple of paragraphs here — this pattern works well for a services page, pricing explanation, or an extended bio."
msgstr "Напишите здесь пару абзацев — этот паттерн подходит для страницы услуг, описания цен или расширенного «обо мне»."

#: inc/blocks/class-block-patterns.php:86
msgid "Soft info panel"
msgstr "Мягкая информационная панель"

#: inc/blocks/class-block-patterns.php:87
msgid "A rounded, softly-coloured box for a highlighted note or quote."
msgstr "Скруглённый блок мягкого цвета для выделенной заметки или цитаты."

#: inc/blocks/class-block-patterns.php:92
msgid "Use this panel to highlight a quote, a note about booking, or anything that should stand out from the rest of the page."
msgstr "Используйте эту панель, чтобы выделить цитату, заметку о бронировании или что-то важное на странице."

#: inc/blocks/class-block-styles.php:18
msgid "Studio Frame Main"
msgstr "Studio Frame — основная"

#: inc/blocks/class-block-styles.php:26
msgid "Studio Frame Secondary"
msgstr "Studio Frame — вторичная"

#: inc/blocks/class-block-styles.php:34
msgid "Soft Panel"
msgstr "Мягкая панель"

#: inc/cmb2/metaboxes-page.php:31
msgid "About Page Content"
msgstr "Содержимое страницы «Обо мне»"

#: inc/cmb2/metaboxes-page.php:42
msgid "Intro text"
msgstr "Вступительный текст"

#: inc/cmb2/metaboxes-page.php:43
msgid "A short paragraph under your name, introducing your style and approach."
msgstr "Короткий абзац под именем, представляющий ваш стиль и подход."

#: inc/cmb2/metaboxes-page.php:51
msgid "Closing statement"
msgstr "Итоговое утверждение"

#: inc/cmb2/metaboxes-page.php:52
msgid "A short bold statement shown above the list below, e.g. \"My work blends mood, story and craft.\""
msgstr "Короткая яркая фраза над списком ниже, например «Моё творчество — синтез настроения, истории и мастерства»."

#: inc/cmb2/metaboxes-page.php:62
msgid "A short list of 2–4 points describing how you work (e.g. \"Capturing moments\", \"Emotion first\")."
msgstr "Короткий список из 2–4 пунктов о вашем подходе к работе (например, «Захватывать моменты», «Эмоция в центре»)."

#: inc/cmb2/metaboxes-page.php:64
msgid "Point {#}"
msgstr "Пункт {#}"

#: inc/cmb2/metaboxes-page.php:65
